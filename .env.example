# Copy to .env and fill. .env is gitignored — never commit real values.

# --- required to run the bot ---
TELEGRAM_BOT_TOKEN=
# Optional preview gate. Comma-separate IDs; leave all three empty for public/open access.
ALLOWED_TELEGRAM_USERS=       # Telegram user IDs that always bypass the passcode
ALLOWED_CHAT_IDS=             # Chat/group IDs whose members all bypass the passcode
TESTER_PASSCODE=              # evaluators can send this once in plain text to unlock their access
GEMINI_API_KEY=                # enable billing on this key. Free-tier throttling mid-judging is
                               # the highest-probability demo failure — ARCHITECTURE.md §1.4
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite  # multimodal/tool-capable failover tier
TRANSCRIPTION_API_KEY=         # optional; defaults to FALLBACK_LLM_API_KEY
TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
FALLBACK_LLM_API_KEY=          # Text-only turns fall through here after both Gemini tiers fail
FALLBACK_URL=                  # OpenAI-compatible /chat/completions endpoint (Cloudflare Workers AI)
FALLBACK_MODEL=                # e.g. @cf/meta/llama-4-scout-17b-16e-instruct
MONGODB_URI=                   # Atlas M0 SRV string. Allow-list Railway's egress IP or it hangs
TOKEN_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SEC_USER_AGENT=                # "Atlas Research your.email@example.com" — SEC 403s without this

# --- required for the finance tools ---
FINNHUB_API_KEY=               # company news, earnings calendar — both confirmed free-tier
                               # web search needs no key: Gemini Google Search grounding

# --- required for Google integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=               # e.g. https://atlas.up.railway.app — OAuth redirect base
                               # Scopes: spreadsheets (READ/WRITE — Atlas writes results back),
                               # gmail/calendar/drive readonly. Configure the write scope on the
                               # consent screen from the start; changing it later re-prompts
                               # anyone already connected. Public link-shared sheets read with no
                               # OAuth at all, so Sheets is never blocked on this

# --- benched. Keys exist but nothing reads them. Don't build against these. ---
ALPHAVANTAGE_API_KEY=          # 25 calls/day — confirmed unusable
FMP_API_KEY=                   # 403s on /quote and /income-statement on free tier — confirmed
POLYGON_API_KEY=               # now "Massive". 5 calls/min, 15-min delayed data — confirmed
                               # (Groq moved above — it's the wired LLM fallback, not benched)
